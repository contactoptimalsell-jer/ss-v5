{
  "buildCommand": "rm -rf node_modules package-lock.json && npm install --no-package-lock && npm run build",
  "outputDirectory": "dist",
  "installCommand": "rm -rf node_modules package-lock.json && npm install --no-package-lock --no-cache",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node"
    }
  }
}
