{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/training/:path*",
      "destination": "https://ss-v5-ochre.vercel.app/:path*"
    },
    {
      "source": "/training",
      "destination": "https://ss-v5-ochre.vercel.app/"
    },
    {
      "source": "/((?!api/|robots.txt|sitemap.xml|training).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
